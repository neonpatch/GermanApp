import { useEffect, useState } from "react";
import axios from "axios";

function ViewArticleTable() {
  const [data, setData] = useState([]);

  useEffect(() => {
    axios.get("http://localhost:8080/api/articles")
      .then(res => setData(res.data));
  }, []);

  return (
    <table border="1">
      <thead>
        <tr>
          <th>Case</th>
          <th>Masculine</th>
          <th>Feminine</th>
          <th>Neuter</th>
          <th>Plural</th>
        </tr>
      </thead>
      <tbody>
        {data.map(item => (
          <tr key={item.id}>
            <td>{item.grammarCase}</td>
            <td>{item.masculine}</td>
            <td>{item.feminine}</td>
            <td>{item.neuter}</td>
            <td>{item.plural}</td>
          </tr>
        ))}
      </tbody>
    </table>
  );
}

export default ViewArticleTable;